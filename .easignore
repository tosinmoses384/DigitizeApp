# Ignore native directories - EAS Build will generate them during prebuild
/ios
/android

# Ignore local build artifacts
*.ipa
*.apk
*.aab

# Ignore node modules (will be installed during build)
node_modules/

# Ignore local environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db
