  "version": "1.0.0",
  "scripts": {
    "start": "EXPO_USE_DEV_CLIENT=false expo start --clear",
    "start:dev-client": "expo start --dev-client",
    "start:android-prod": "APP_VARIANT=production npx expo start --dev-client",
    "build:dev-android-prod": "eas build -p android --profile production-dev",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "build:android-dev": "eas build --profile development --platform android",
    "build:ios-dev": "eas build --profile development --platform ios",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:ios": "cd ios && xcodebuild clean && cd ..",
    "validate-config": "./scripts/validate-config.sh",
    "config:check": "npm run validate-config",
    "config:help": "echo '📖 See docs/GOOGLE_SERVICES_SETUP.md for configuration instructions'",
    "setup-google-services": "node scripts/copy-google-services.js",
    "test-google-services": "node scripts/test-google-services.js",
    "postinstall": "patch-package"
  },
